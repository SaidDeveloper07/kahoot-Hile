// ==UserScript==
// @name         said Kahoot Auto
// @namespace    said
// @version      1.0.0
// @description  Kahoot otomatik doğru cevap — açar açmaz çalışır
// @author       said
// @match        *://kahoot.it/*
// @match        *://*.kahoot.it/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
  "use strict";

  const CFG = {
    autoAnswer: true,       // açar açmaz tıkla
    showAnswers: true,      // doğru şıkları yeşil göster
    baseDelay: 400,         // ms (çok hızlı = 0 puan riski)
    randomDelay: 350,       // ± rastgele
    multiStagger: 60
  };

  let quizData = null;      // { questions: [...] }
  let lastQText = "";
  let lastAnswered = -1;

  // ─── API: public quiz answers ─────────────────────────────────
  // Challenge / public quiz: rest/challenges/{id}
  // Classic live: quiz uuid gerekir (host URL veya challenge-id)
  async function fetchByChallengeId(id) {
    const urls = [
      `https://kahoot.it/rest/challenges/${id}`,
      `https://kahoot.it/rest/challenges/${id}/answers`,
      `https://create.kahoot.it/rest/kahoots/${id}/card/?includeKahoot=true`
    ];
    for (const u of urls) {
      try {
        const r = await fetch(u, { credentials: "include" });
        if (!r.ok) continue;
        const j = await r.json();
        const qs = extractQuestions(j);
        if (qs && qs.length) return qs;
      } catch (_) {}
    }
    return null;
  }

  function extractQuestions(j) {
    // multiple response shapes
    if (j?.kahoot?.questions) return j.kahoot.questions;
    if (j?.questions) return j.questions;
    if (j?.challenge?.kahoot?.questions) return j.challenge.kahoot.questions;
    if (Array.isArray(j)) return j;
    return null;
  }

  function getCorrectIndexes(q) {
    if (!q) return [];
    const choices = q.choices || q.answers || [];
    const idxs = [];
    choices.forEach((c, i) => {
      if (c.correct === true || c.isCorrect === true) idxs.push(i);
    });
    return idxs;
  }

  function normalize(s) {
    return String(s || "")
      .replace(/<[^>]+>/g, "")
      .replace(/\s+/g, " ")
      .trim()
      .toLowerCase();
  }

  function matchQuestion(liveText) {
    if (!quizData || !quizData.length) return null;
    const t = normalize(liveText);
    if (!t) return null;
    let best = null, bestScore = 0;
    for (let i = 0; i < quizData.length; i++) {
      const qt = normalize(quizData[i].question || quizData[i].title || "");
      if (!qt) continue;
      if (qt === t) return { q: quizData[i], index: i };
      // partial
      if (t.includes(qt.slice(0, 40)) || qt.includes(t.slice(0, 40))) {
        const score = Math.min(t.length, qt.length);
        if (score > bestScore) {
          bestScore = score;
          best = { q: quizData[i], index: i };
        }
      }
    }
    return best;
  }

  // ─── DOM helpers (güncel kahoot selectors) ────────────────────
  function qSel(sel) {
    return document.querySelector(`[data-functional-selector="${sel}"]`);
  }

  function getQuestionText() {
    const el =
      qSel("question-title") ||
      qSel("block-title") ||
      document.querySelector('[data-functional-selector*="question"]') ||
      document.querySelector(".question-title, h1, [class*='question']");
    return el ? el.textContent : "";
  }

  function getAnswerButtons() {
    // classic 4-choice + multi
    let btns = Array.from(
      document.querySelectorAll(
        '[data-functional-selector^="answer-"], [data-functional-selector="question-choice"], button[data-functional-selector*="answer"]'
      )
    );
    if (!btns.length) {
      btns = Array.from(
        document.querySelectorAll(
          ".answer, .mcq-answer, [class*='answer-button'], button[class*='choice']"
        )
      );
    }
    // sadece tıklanabilir görünenler
    return btns.filter((b) => {
      const r = b.getBoundingClientRect();
      return r.width > 20 && r.height > 20 && getComputedStyle(b).visibility !== "hidden";
    });
  }

  function highlight(btns, idxs) {
    btns.forEach((b, i) => {
      if (idxs.includes(i)) {
        b.style.outline = "3px solid #00e676";
        b.style.boxShadow = "0 0 12px #00e676";
        b.style.zIndex = "5";
      } else {
        b.style.outline = "";
        b.style.boxShadow = "";
      }
    });
  }

  function clickAnswer(btns, idxs) {
    if (!idxs.length || !btns.length) return;
    idxs.forEach((i, n) => {
      setTimeout(() => {
        const b = btns[i];
        if (!b) return;
        b.dispatchEvent(new PointerEvent("pointerdown", { bubbles: true }));
        b.dispatchEvent(new MouseEvent("mousedown", { bubbles: true }));
        b.click();
        b.dispatchEvent(new MouseEvent("mouseup", { bubbles: true }));
        b.dispatchEvent(new PointerEvent("pointerup", { bubbles: true }));
      }, n * CFG.multiStagger);
    });
  }

  // ─── main tick ────────────────────────────────────────────────
  function tick() {
    const text = getQuestionText();
    if (!text || text === lastQText) return;

    const match = matchQuestion(text);
    if (!match) {
      status("soru eşleşmedi — quiz id lazım");
      return;
    }

    lastQText = text;
    const idxs = getCorrectIndexes(match.q);
    const btns = getAnswerButtons();

    if (CFG.showAnswers) highlight(btns, idxs);

    if (CFG.autoAnswer && match.index !== lastAnswered && idxs.length) {
      lastAnswered = match.index;
      const delay =
        CFG.baseDelay + Math.floor(Math.random() * (CFG.randomDelay + 1));
      status(`cevap #${idxs.map((i) => i + 1).join(",")} · ${delay}ms`);
      setTimeout(() => {
        const fresh = getAnswerButtons();
        clickAnswer(fresh.length ? fresh : btns, idxs);
      }, delay);
    }

    status(`Q ${match.index + 1}/${quizData.length}`);
  }

  // ─── auto discover challenge / quiz id from URL ───────────────
  function discoverId() {
    const u = location.href;
    // challenge-id=uuid_timestamp
    let m = u.match(/challenge-id=([a-f0-9-]{36}_?\d*)/i);
    if (m) return m[1];
    m = u.match(/challenge\/([a-f0-9-]{36}(?:_\d+)?)/i);
    if (m) return m[1];
    m = u.match(/\/details\/([a-f0-9-]{36})/i);
    if (m) return m[1];
    m = u.match(/[?&]quizId=([a-f0-9-]{36})/i);
    if (m) return m[1];
    // path uuid
    m = u.match(/([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})/i);
    if (m) return m[1];
    return null;
  }

  // ─── intercept network for live quiz payload ──────────────────
  const _fetch = window.fetch;
  window.fetch = async function (...args) {
    const res = await _fetch.apply(this, args);
    try {
      const url = String(args[0] || "");
      if (
        /kahoot\.it\/rest\/i.test(url) ||
        /create\.kahoot\.it\/i.test(url) ||
        /challenges\//i.test(url)
      ) {
        const clone = res.clone();
        clone.json().then((j) => {
          const qs = extractQuestions(j);
          if (qs && qs.length) {
            quizData = qs;
            status(`quiz yüklendi · ${qs.length} soru`);
          }
        }).catch(() => {});
      }
    } catch (_) {}
    return res;
  };

  // XHR de yakala
  const _open = XMLHttpRequest.prototype.open;
  XMLHttpRequest.prototype.open = function (method, url, ...rest) {
    this.addEventListener("load", function () {
      try {
        if (typeof this.responseText === "string" && /kahoot|challenge|question/i.test(url)) {
          const j = JSON.parse(this.responseText);
          const qs = extractQuestions(j);
          if (qs && qs.length) {
            quizData = qs;
            status(`quiz yüklendi · ${qs.length} soru`);
          }
        }
      } catch (_) {}
    });
    return _open.call(this, method, url, ...rest);
  };

  // ─── mini UI ──────────────────────────────────────────────────
  let statusEl = null;
  function buildUI() {
    if (document.getElementById("said-kahoot")) return;
    const box = document.createElement("div");
    box.id = "said-kahoot";
    box.style.cssText = `
      position:fixed;top:12px;right:12px;z-index:999999;
      background:rgba(0,0,0,0.88);color:#fff;font:12px/1.3 monospace;
      padding:10px 12px;border-radius:8px;border:1px solid #222;
      min-width:200px;max-width:280px;user-select:none;
    `;
    box.innerHTML = `
      <div style="font-weight:700;margin-bottom:6px;">said kahoot</div>
      <input id="said-kid" placeholder="Quiz ID (uuid)" style="
        width:100%;box-sizing:border-box;background:#111;border:1px solid #333;
        color:#fff;padding:6px 8px;border-radius:4px;margin-bottom:6px;font:11px monospace;
      "/>
      <button id="said-load" style="
        width:100%;padding:6px;background:#fff;color:#000;border:none;
        border-radius:4px;font-weight:700;cursor:pointer;margin-bottom:6px;
      ">yükle</button>
      <label style="display:flex;align-items:center;gap:6px;margin:4px 0;">
        <input type="checkbox" id="said-auto" ${CFG.autoAnswer ? "checked" : ""}/> auto answer
      </label>
      <label style="display:flex;align-items:center;gap:6px;margin:4px 0;">
        <input type="checkbox" id="said-show" ${CFG.showAnswers ? "checked" : ""}/> highlight
      </label>
      <div id="said-status" style="color:#8f8;margin-top:6px;font-size:11px;">hazır</div>
    `;
    document.documentElement.appendChild(box);

    statusEl = document.getElementById("said-status");
    document.getElementById("said-auto").onchange = (e) => {
      CFG.autoAnswer = e.target.checked;
    };
    document.getElementById("said-show").onchange = (e) => {
      CFG.showAnswers = e.target.checked;
    };
    document.getElementById("said-load").onclick = async () => {
      const id = document.getElementById("said-kid").value.trim() || discoverId();
      if (!id) {
        status("id yok");
        return;
      }
      status("yükleniyor…");
      const qs = await fetchByChallengeId(id);
      if (qs) {
        quizData = qs;
        status(`ok · ${qs.length} soru`);
      } else {
        status("yüklenemedi (private?)");
      }
    };
  }

  function status(t) {
    if (statusEl) statusEl.textContent = t;
  }

  // ─── boot ─────────────────────────────────────────────────────
  function boot() {
    buildUI();
    const id = discoverId();
    if (id) {
      document.getElementById("said-kid").value = id;
      fetchByChallengeId(id).then((qs) => {
        if (qs) {
          quizData = qs;
          status(`auto · ${qs.length} soru`);
        }
      });
    }
    setInterval(tick, 400);
  }

  if (document.body) boot();
  else document.addEventListener("DOMContentLoaded", boot);
})();
