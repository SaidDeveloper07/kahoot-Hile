// ==UserScript==
// @name         Kahoot Said Auto-Answer
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  Kahoot Auto-Answer with Draggable UI
// @match        *://kahoot.it/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function() {
    'use strict';

    // State & "Offsets" (Dynamic Web Hooks)
    const State = {
        autoAnswer: false,
        correctAnswers: [],
        currentQuestion: 0,
        quizData: null,
        menuOpen: true
    };

    const Offsets = {
        apiEndpoint: "/rest/kahoots/",
        answerNode: "data-functional-selector",
        buttonPrefix: "answer-"
    };

    // UI Construction
    function createMenu() {
        const menu = document.createElement('div');
        menu.id = 'said-draggable-menu';
        menu.style.position = 'fixed';
        menu.style.top = '20px';
        menu.style.left = '20px';
        menu.style.width = '200px';
        menu.style.backgroundColor = '#050505';
        menu.style.color = '#ffffff';
        menu.style.border = '1px solid #333';
        menu.style.borderRadius = '5px';
        menu.style.zIndex = '999999';
        menu.style.fontFamily = 'monospace';
        menu.style.boxShadow = '0px 0px 10px rgba(0,0,0,0.8)';
        menu.style.userSelect = 'none';

        // Header (Draggable Area)
        const header = document.createElement('div');
        header.style.backgroundColor = '#111';
        header.style.padding = '8px';
        header.style.borderBottom = '1px solid #333';
        header.style.cursor = 'move';
        header.style.fontWeight = 'bold';
        header.style.textAlign = 'center';
        header.innerText = 'Said';
        
        // Minimize Button
        const minBtn = document.createElement('span');
        minBtn.innerText = '[-]';
        minBtn.style.float = 'right';
        minBtn.style.cursor = 'pointer';
        minBtn.style.color = '#aaa';
        header.appendChild(minBtn);

        const content = document.createElement('div');
        content.style.padding = '10px';

        content.innerHTML = `
            <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer; font-size: 12px;">
                <span>Auto-Answer</span>
                <input type="checkbox" id="said-auto">
            </label>
            <div id="said-status" style="margin-top: 10px; font-size: 10px; color: #0f0;">Status: Hooking...</div>
        `;

        menu.appendChild(header);
        menu.appendChild(content);
        document.body.appendChild(menu);

        // Drag Logic
        let isDragging = false;
        let offsetX, offsetY;

        header.addEventListener('mousedown', (e) => {
            if (e.target === minBtn) return;
            isDragging = true;
            offsetX = e.clientX - menu.getBoundingClientRect().left;
            offsetY = e.clientY - menu.getBoundingClientRect().top;
        });

        document.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            menu.style.left = (e.clientX - offsetX) + 'px';
            menu.style.top = (e.clientY - offsetY) + 'px';
        });

        document.addEventListener('mouseup', () => {
            isDragging = false;
        });

        // Toggle logic
        minBtn.addEventListener('click', () => {
            State.menuOpen = !State.menuOpen;
            content.style.display = State.menuOpen ? 'block' : 'none';
        });

        document.getElementById('said-auto').addEventListener('change', (e) => {
            State.autoAnswer = e.target.checked;
        });
    }

    // JSON Parser Hook to intercept Quiz Data and correct IDs
    function hookData() {
        const originalParse = JSON.parse;
        JSON.parse = function(text, reviver) {
            const data = originalParse(text, reviver);
            try {
                // Intercept question data payload
                if (data && data.questions && Array.isArray(data.questions)) {
                    State.quizData = data;
                    State.correctAnswers = data.questions.map(q => {
                        let correctIdxs = [];
                        if (q.choices) {
                            q.choices.forEach((choice, idx) => {
                                if (choice.correct) correctIdxs.push(idx);
                            });
                        }
                        return correctIdxs;
                    });
                    
                    const status = document.getElementById('said-status');
                    if (status) status.innerText = `Status: Loaded ${data.questions.length} Qs`;
                }
            } catch (e) {}
            return data;
        };

        // Hook WebSocket to track question progression
        const OrigWebSocket = window.WebSocket;
        window.WebSocket = function(...args) {
            const ws = new OrigWebSocket(...args);
            ws.addEventListener('message', function(event) {
                try {
                    const msg = JSON.parse(event.data);
                    if (msg[0] && msg[0].data && typeof msg[0].data.questionIndex !== 'undefined') {
                        State.currentQuestion = msg[0].data.questionIndex;
                        if (State.autoAnswer) {
                            setTimeout(executeAnswer, 500); // Small delay to let DOM render
                        }
                    }
                } catch (e) {}
            });
            return ws;
        };
    }

    // Auto-Clicker Logic
    function executeAnswer() {
        if (!State.autoAnswer || State.correctAnswers.length === 0) return;
        
        let correctIds = State.correctAnswers[State.currentQuestion];
        if (!correctIds || correctIds.length === 0) return;

        // Kahoot buttons are typically ordered 0-3 (Red, Blue, Yellow, Green)
        let targetId = correctIds[0];
        
        // Find DOM element based on current layout offsets
        const buttons = document.querySelectorAll(`[${Offsets.answerNode}^="${Offsets.buttonPrefix}"]`);
        if (buttons.length > targetId) {
            // Simulate natural click
            buttons[targetId].click();
            console.log(`[Said] Auto-clicked answer ID: ${targetId}`);
        }
    }

    // DOM Observer for late-rendering buttons
    const observer = new MutationObserver(() => {
        if (State.autoAnswer && document.querySelector(`[${Offsets.answerNode}^="${Offsets.buttonPrefix}"]`)) {
            // Attempt to answer if question screen just rendered
            if (!document.saidAnswered) {
                executeAnswer();
                document.saidAnswered = true;
                setTimeout(() => { document.saidAnswered = false; }, 5000);
            }
        }
    });

    // Init
    window.addEventListener('DOMContentLoaded', () => {
        createMenu();
        observer.observe(document.body, { childList: true, subtree: true });
    });

    hookData();

})();
