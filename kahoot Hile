// ==UserScript==
// @name         SAID Kahoot Auto Answer
// @namespace    said
// @version      1.0
// @description  Auto correct answers for Kahoot
// @author       said
// @match        *://kahoot.it/*
// @match        *://*.kahoot.it/*
// @grant        none
// @run-at       document-end
// ==/UserScript==

(function SAID_KAHOOT() {
  "use strict";

  let answers = []; // questionIndex -> correct choice index(es)
  let quizId = null;
  let running = false;

  function log(m) {
    console.log("%c[SAID]%c " + m, "background:#000;color:#0f0;padding:2px 6px", "color:#0f0");
  }

  // Quiz UUID ile doğru cevapları çek
  async function loadAnswers(uuid) {
    answers = [];
    if (!uuid) return false;
    const urls = [
      "https://create.kahoot.it/rest/kahoots/" + uuid,
      "https://kahoot.it/rest/kahoots/" + uuid
    ];
    for (const u of urls) {
      try {
        const r = await fetch(u, { headers: { Accept: "application/json" } });
        if (!r.ok) continue;
        const data = await r.json();
        if (!data.questions) continue;
        answers = data.questions.map((q) => {
          if (!q.choices) return [0];
          const correct = [];
          q.choices.forEach((c, i) => { if (c.correct) correct.push(i); });
          return correct.length ? correct : [0];
        });
        log("Yüklendi: " + answers.length + " soru");
        return true;
      } catch {}
    }
    log("Quiz verisi alınamadı");
    return false;
  }

  // URL / sayfadan quizId yakala
  function findQuizId() {
    const href = location.href;
    let m = href.match(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i);
    if (m) return m[0];
    m = href.match(/quizId=([0-9a-f-]+)/i);
    if (m) return m[1];
    try {
      const scripts = document.querySelectorAll("script");
      for (const s of scripts) {
        const t = s.textContent || "";
        const mm = t.match(/"uuid"\s*:\s*"([0-9a-f-]{36})"/i);
        if (mm) return mm[1];
      }
    } catch {}
    return null;
  }

  // Ekrandaki şıklara tıkla (DOM auto answer)
  function clickChoice(index) {
    // Kahoot buton sırası: 0 kırmızı, 1 mavi, 2 sarı, 3 yeşil
    const selectors = [
      '[data-functional-selector="answer-0"]',
      '[data-functional-selector="answer-1"]',
      '[data-functional-selector="answer-2"]',
      '[data-functional-selector="answer-3"]',
      'button[data-testid="answer-0"]',
      'button[data-testid="answer-1"]',
      'button[data-testid="answer-2"]',
      'button[data-testid="answer-3"]'
    ];

    // önce data-functional
    let btn = document.querySelector('[data-functional-selector="answer-' + index + '"]');
    if (!btn) {
      const all = document.querySelectorAll('[data-functional-selector^="answer-"]');
      if (all[index]) btn = all[index];
    }
    if (!btn) {
      const choices = document.querySelectorAll('[class*="choice"], [class*="answer-button"], button[class*="answer"]');
      if (choices[index]) btn = choices[index];
    }
    if (btn) {
      btn.click();
      log("Tıklandı şık " + index);
      return true;
    }
    return false;
  }

  let lastQ = -1;

  function tryAnswer() {
    if (!running) return;

    // soru numarası / index bul
    let qIndex = lastQ + 1;
    try {
      const counter = document.querySelector('[data-functional-selector="question-index"]') ||
        document.querySelector('[class*="question-count"]');
      if (counter) {
        const t = counter.textContent || "";
        const mm = t.match(/(\d+)/);
        if (mm) qIndex = parseInt(mm[1], 10) - 1;
      }
    } catch {}

    if (qIndex === lastQ) return;

    // şıklar görünür mü
    const hasChoices =
      document.querySelector('[data-functional-selector^="answer-"]') ||
      document.querySelectorAll('button[class*="answer"]').length >= 2;

    if (!hasChoices) return;

    let choice = 0;
    if (answers[qIndex] && answers[qIndex].length) {
      choice = answers[qIndex][0];
    } else {
      choice = Math.floor(Math.random() * 4);
    }

    const delay = 300 + Math.random() * 900;
    setTimeout(() => {
      if (clickChoice(choice)) lastQ = qIndex;
    }, delay);
  }

  // SAID mini menü
  function menu() {
    if (document.getElementById("said-kh")) return;
    const d = document.createElement("div");
    d.id = "said-kh";
    d.style.cssText = [
      "position:fixed", "top:12px", "right:12px", "z-index:999999",
      "background:#000", "color:#0f0", "border:1px solid #222",
      "padding:12px", "font:12px monospace", "border-radius:8px",
      "width:240px"
    ].join(";");
    d.innerHTML = `
      <div style="letter-spacing:3px;text-align:center;margin-bottom:8px;color:#fff">SAID</div>
      <input id="said-uuid" placeholder="Quiz UUID" style="width:100%;margin:4px 0;padding:6px;background:#111;color:#fff;border:1px solid #333">
      <button id="said-start" style="width:100%;padding:8px;margin-top:4px;background:#111;color:#0f0;border:1px solid #0f0;cursor:pointer">AUTO ON</button>
      <button id="said-stop" style="width:100%;padding:8px;margin-top:4px;background:#111;color:#f44;border:1px solid #f44;cursor:pointer">OFF</button>
      <div id="said-st" style="margin-top:6px;font-size:10px;color:#666">kapalı</div>
    `;
    document.body.appendChild(d);

    document.getElementById("said-start").onclick = async () => {
      const input = document.getElementById("said-uuid").value.trim();
      quizId = input || findQuizId();
      if (quizId) {
        document.getElementById("said-uuid").value = quizId;
        await loadAnswers(quizId);
      } else {
        log("UUID yok — rastgele cevap");
      }
      running = true;
      lastQ = -1;
      document.getElementById("said-st").textContent = "aktif · auto answer";
      log("Auto answer AÇIK");
    };

    document.getElementById("said-stop").onclick = () => {
      running = false;
      document.getElementById("said-st").textContent = "kapalı";
      log("Kapalı");
    };
  }

  // MutationObserver — soru değişince cevapla
  const obs = new MutationObserver(() => tryAnswer());
  function boot() {
    menu();
    obs.observe(document.body, { childList: true, subtree: true });
    setInterval(tryAnswer, 800);
    const autoId = findQuizId();
    if (autoId) {
      document.getElementById("said-uuid").value = autoId;
      loadAnswers(autoId);
    }
    log("SAID Kahoot yüklendi");
  }

  if (document.body) boot();
  else document.addEventListener("DOMContentLoaded", boot);
})();
